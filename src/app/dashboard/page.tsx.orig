import { PrismaClient } from '@prisma/client';
import { revalidatePath } from 'next/cache';
import { getServerSession } from "next-auth/next";
import { redirect } from 'next/navigation';
import { authOptions } from "../api/auth/[...nextauth]/route";

const prisma = new PrismaClient();



async function assignTechnician(formData: FormData) {
  'use server';
  
  const requestId = formData.get('requestId') as string;
  const technicianId = formData.get('technicianId') as string;

  if (requestId && technicianId) {
    await prisma.repairRequest.update({
      where: { id: requestId },
      data: {
        technicianId,
        status: 'IN_PROGRESS'
      }
    });
    revalidatePath('/dashboard');
  }
}

export default async function Dashboard() {

  const session = await getServerSession(authOptions as any) as any;
  if (!session) {
    redirect('/login');
  }

  const requests = await prisma.repairRequest.findMany({
    include: {
      equipment: {
        include: { facility: true }
      },
      technician: true
    },
    orderBy: { createdAt: 'desc' }
  });

  const technicians = await prisma.user.findMany({
    where: { role: 'TECHNICIAN' }
  });

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col md:flex-row">
      {/* Sidebar sidebar */}
      <aside className="w-full md:w-64 bg-white border-r border-slate-200 p-6 flex-shrink-0">
        <div className="flex items-center gap-3 mb-10">
          <div className="w-8 h-8 bg-[#0066b3] rounded-lg flex items-center justify-center">
            <svg className="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <div>
            <h1 className="font-bold text-slate-900 text-lg leading-tight">МедТехСервис</h1>
            <p className="text-xs text-slate-500 uppercase tracking-wider font-semibold">Инженерный CMMS</p>
          </div>
        </div>

        <nav className="space-y-1">
          <a href="#" className="flex items-center gap-3 px-3 py-2.5 bg-blue-50 text-[#0066b3] rounded-lg font-medium">
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
            Диспетчерская
            <span className="ml-auto bg-[#0066b3] text-white text-xs py-0.5 px-2 rounded-full">{requests.length}</span>
          </a>
          <a href="#" className="flex items-center gap-3 px-3 py-2.5 text-slate-600 hover:bg-slate-100 rounded-lg font-medium transition-colors">
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            Оборудование
          </a>
          <a href="/client" target="_blank" className="flex items-center gap-3 px-3 py-2.5 text-slate-600 hover:bg-slate-100 rounded-lg font-medium transition-colors">
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
            QR-Заявка (Моб)
          </a>
        </nav>
      </aside>

      {/* Main content */}
      <main className="flex-1 overflow-hidden flex flex-col">
        <header className="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center h-16">
          <div className="relative w-96">
            <svg className="w-5 h-5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <input 
              type="text" 
              placeholder="Поиск по S/N, названию клиники, тикету..." 
              className="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0066b3] focus:border-transparent transition-all"
            />
          </div>
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2 px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-sm font-medium">
              <span className="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
              Экстренный вызов
            </div>
            <div className="w-px h-6 bg-slate-200 mx-2"></div>
            <div className="flex items-center gap-3">
              <div className="text-right">
                <p className="text-sm font-bold text-slate-900">{session?.user?.name || 'Диспетчер'}</p>
                <p className="text-xs text-slate-500">Главный пульт</p>
              </div>
              <div className="w-10 h-10 bg-[#0066b3] rounded-full flex items-center justify-center text-white font-bold">
                {session?.user?.name ? session.user.name.charAt(0) : 'Д'}
              </div>
            </div>
          </div>
        </header>

        <div className="p-8 overflow-y-auto flex-1">
          <div className="flex justify-between items-end mb-6">
            <div>
              <h2 className="text-2xl font-bold text-slate-900">Сводка инцидентов</h2>
              <p className="text-slate-500 text-sm mt-1">Управление заявками и распределение нарядов</p>
            </div>
          </div>
          
          <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-slate-200">
                <thead className="bg-slate-50">
                  <tr>
                    <th className="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Тикет / Оборудование</th>
                    <th className="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Учреждение</th>
                    <th className="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Симптом</th>
                    <th className="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Статус</th>
                    <th className="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Назначение</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-slate-100">
                  {requests.map((req) => (
                    <tr key={req.id} className="hover:bg-slate-50 transition-colors">
                      <td className="px-6 py-4">
                        <div className="flex items-center">
                          <div className="w-10 h-10 flex-shrink-0 bg-blue-50 rounded-lg flex items-center justify-center">
                             <svg className="w-6 h-6 text-[#0066b3]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                          </div>
                          <div className="ml-4">
                            <div className="text-sm font-bold text-slate-900">REQ-{req.id.substring(0,6).toUpperCase()}</div>
                            <div className="text-xs text-slate-500 mt-0.5">{req.equipment.name}</div>
                          </div>
                        </div>
                      </td>
                      <td className="px-6 py-4">
                        <div className="text-sm font-medium text-slate-900">{req.equipment.facility.name}</div>
                        <div className="text-xs text-slate-500 mt-0.5">S/N: {req.equipment.serialNumber || 'N/A'}</div>
                      </td>
                      <td className="px-6 py-4">
                         <div className="text-sm text-slate-700 max-w-xs truncate" title={req.description}>{req.description}</div>
                         <div className="text-xs text-slate-400 mt-0.5">{new Date(req.createdAt).toLocaleDateString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</div>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className={`px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full 
                          ${req.status === 'PENDING' ? 'bg-amber-100 text-amber-800 border border-amber-200' : 
                            req.status === 'IN_PROGRESS' ? 'bg-blue-100 text-blue-800 border border-blue-200' : 
                            'bg-emerald-100 text-emerald-800 border border-emerald-200'}`}>
                          {req.status === 'PENDING' ? 'НОВАЯ' : req.status === 'IN_PROGRESS' ? 'В РАБОТЕ' : 'ЗАВЕРШЕНО'}
                        </span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <form action={assignTechnician} className="flex flex-col gap-2">
                          <input type="hidden" name="requestId" value={req.id} />
                          <div className="flex gap-2">
                            <select
                              name="technicianId"
                              defaultValue={req.technicianId || ""}
                              className="block w-full text-sm rounded-lg border-slate-200 shadow-sm focus:border-[#0066b3] focus:ring-[#0066b3] py-1.5 px-2 bg-slate-50"
                              required
                            >
                              <option value="" disabled>Специалист...</option>
                              {technicians.map((tech) => (
                                <option key={tech.id} value={tech.id}>
                                  {tech.name || 'Специалист'}
                                </option>
                              ))}
                            </select>
                            <button
                              type="submit"
                              className={`text-xs px-3 py-1.5 rounded-lg shadow-sm font-semibold transition-colors
                                ${req.technician ? 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50' : 'bg-[#0066b3] text-white hover:bg-[#005299] border border-transparent'}`}
                            >
                              {req.technician ? 'Изменить' : 'Назначить'}
                            </button>
                          </div>
                          {req.technician && (
                             <div className="text-xs text-slate-500 flex items-center gap-1 mt-1">
                                <svg className="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd" /></svg>
                                Текущий: {req.technician.name}
                             </div>
                          )}
                        </form>
                      </td>
                    </tr>
                  ))}
                  {requests.length === 0 && (
                    <tr>
                      <td colSpan={5} className="px-6 py-8 text-center text-sm text-slate-500">
                        <div className="flex flex-col items-center">
                          <svg className="w-12 h-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                          Активных инцидентов нет.
                        </div>
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  );
}

